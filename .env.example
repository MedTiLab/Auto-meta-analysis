# AutoMeta Environment Configuration
# Full reference: docs/configuration.md

# =============================================================================
# SERVER
# =============================================================================
PORT=3001
VITE_PORT=5173
# Host/IP to bind servers to (default: 0.0.0.0 for all interfaces)
# Use 127.0.0.1 to restrict to localhost only
HOST=127.0.0.1
# CLAUDE_CLI_PATH=claude
# CURSOR_CLI_PATH=agent
# GEMINI_CLI_PATH=gemini
# CODEX_CLI_PATH=codex

# =============================================================================
# CONTEXT WINDOW
# =============================================================================
CONTEXT_WINDOW=1000000
VITE_CONTEXT_WINDOW=1000000
# =============================================================================
# DATABASE
# =============================================================================
# DATABASE_PATH=/path/to/custom/auth.db

# Optional additional protection for non-local deployments.
# API_KEY=

# =============================================================================
# PLATFORM MODE  (advanced — most users leave these commented out)
# =============================================================================
# VITE_IS_PLATFORM=false
# WORKSPACES_ROOT=/home/user/autometa_workspace
# When enabled, new projects use the single configured WORKSPACES_ROOT and
# custom per-project paths are disabled. No username or user-id folder is added.
# MEDAUTODATA_LOCK_PROJECT_PATHS=true
# Set only when you intentionally want to import legacy MedHelp/MedAutoData data.
# AUTOMETA_IMPORT_LEGACY_DATA=false

# =============================================================================
# INTEGRATIONS  (optional)
# =============================================================================
# GEMINI_API_KEY=sk-...
# GEMINI_API_BASE_URL=https://api.go-model.com
# GOOGLE_API_KEY=AIza...  # legacy alias for Gemini-compatible integrations
# OPENAI_API_KEY=sk-...

# =============================================================================
# LLM PROVIDERS  (optional advanced overrides)
# =============================================================================
# Provider configuration is normally managed through /api/providers and stored
# under the application data directory. Override that directory only for
# isolated/headless deployments.
# MEDAUTODATA_PROVIDER_DIR=/path/to/provider-config
# LLM_PROVIDER_TEST_TIMEOUT_MS=30000
# LLM_PROVIDER_REQUEST_TIMEOUT_MS=300000
# The protocol bridge is loopback-only. Enabling remote access can spend saved
# provider quota and is strongly discouraged.
# MEDAUTODATA_ALLOW_REMOTE_PROVIDER_PROXY=false
# Native Claude cloud backends supported by the Agent SDK:
# CLAUDE_CODE_USE_BEDROCK=1
# AWS_REGION=us-east-1
# AWS_PROFILE=default
# CLAUDE_CODE_USE_VERTEX=1
# ANTHROPIC_VERTEX_PROJECT_ID=your-gcp-project
# CLOUD_ML_REGION=us-east5
# CLAUDE_CODE_USE_FOUNDRY=1
# ANTHROPIC_FOUNDRY_RESOURCE=your-resource
# ANTHROPIC_FOUNDRY_API_KEY=...
# Azure OpenAI is available as the azure_openai_responses API format in a
# custom provider; include ?api-version=... in the Base URL to override default.

# =============================================================================
# ADVANCED
# =============================================================================
# CLAUDE_TOOL_APPROVAL_TIMEOUT_MS=55000

# =============================================================================
# ZOTERO / MEDHELP AGENT API ENV  (optional)
# =============================================================================
# AI CLI sessions receive user-scoped Zotero credentials and MedHelp JWT automatically
# from the app when they are saved in Settings. These process-level values are only
# fallback defaults for local development or headless runs.
# ZOTERO_API_KEY=XXXXXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ZOTERO_USER_ID=123456
# ZOTERO_API_BASE_URL=https://api.zotero.org
# MEDHELP_API_BASE_URL=http://127.0.0.1:3001

# =============================================================================
# API for MinerU
# =============================================================================
# Settings → Integrations → MinerU stores a per-user token. This process-level
# value remains the fallback for local development and headless runs.
# MINERU_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
